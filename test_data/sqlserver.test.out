CREATE TABLE [dbo].[ConstraintsAndDefaults](
	[Id] [int] NOT NULL,
	[Code] [nvarchar](20) NOT NULL,
	[Status] [varchar](20) NOT NULL DEFAULT ('pending'),
	[Quantity] [int] NOT NULL DEFAULT ((1)),
	[DoubleQty] AS ([Quantity]*(2)) PERSISTED,
 CONSTRAINT [PK_ConstraintsAndDefaults] PRIMARY KEY CLUSTERED 
(
	[Id] ASC
)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRIMARY],
 CONSTRAINT [UQ_ConstraintsAndDefaults_Code] UNIQUE NONCLUSTERED 
(
	[Code] ASC
)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRIMARY],
 CONSTRAINT [CK_ConstraintsAndDefaults_Quantity] CHECK (([Quantity]>(0)))
) ON [PRIMARY]
GO
CREATE NONCLUSTERED INDEX [IX_ConstraintsAndDefaults_Status_QtyDesc] ON [dbo].[ConstraintsAndDefaults]
(
	[Status] ASC,
	[Quantity] DESC
) ON [PRIMARY]
