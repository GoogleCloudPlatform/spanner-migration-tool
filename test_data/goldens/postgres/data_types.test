-- pg_numeric_and_integer_types
CREATE TABLE numeric_types (
    id bigint PRIMARY KEY,
    int8_col int8,
    bigint_col bigint,
    int4_col int4,
    integer_col integer,
    int2_col int2,
    smallint_col smallint,
    oid_col oid,
    money_col money,
    numeric_at_limit numeric(38,9),
    numeric_precision_overflow numeric(39,9),
    numeric_scale_overflow numeric(20,10),
    numeric_intdigits_overflow numeric(38,2),
    numeric_bare numeric,
    decimal_col decimal(10,2)
)
-- GoogleSQL
CREATE TABLE `numeric_types` (
    `id` INT64 NOT NULL ,
    `int8_col` INT64,
    `bigint_col` INT64,
    `int4_col` INT64,
    `integer_col` INT64,
    `int2_col` INT64,
    `smallint_col` INT64,
    `oid_col` INT64,
    `money_col` NUMERIC,
    `numeric_at_limit` NUMERIC,
    `numeric_precision_overflow` STRING(MAX),
    `numeric_scale_overflow` STRING(MAX),
    `numeric_intdigits_overflow` STRING(MAX),
    `numeric_bare` NUMERIC,
    `decimal_col` NUMERIC,
) PRIMARY KEY (`id`)
-- PostgreSQL
CREATE TABLE "numeric_types" (
    "id" INT8 NOT NULL ,
    "int8_col" INT8,
    "bigint_col" INT8,
    "int4_col" INT8,
    "integer_col" INT8,
    "int2_col" INT8,
    "smallint_col" INT8,
    "oid_col" INT8,
    "money_col" NUMERIC,
    "numeric_at_limit" NUMERIC,
    "numeric_precision_overflow" VARCHAR(2621440),
    "numeric_scale_overflow" VARCHAR(2621440),
    "numeric_intdigits_overflow" VARCHAR(2621440),
    "numeric_bare" NUMERIC,
    "decimal_col" NUMERIC,
    PRIMARY KEY ("id")
)
==
-- pg_uuid_and_network_types
CREATE TABLE uuid_network_types (
    id uuid PRIMARY KEY,
    uuid_col uuid,
    inet_col inet,
    cidr_col cidr,
    macaddr_col macaddr,
    macaddr8_col macaddr8
)
-- GoogleSQL
CREATE TABLE `uuid_network_types` (
    `id` UUID NOT NULL ,
    `uuid_col` UUID,
    `inet_col` STRING(MAX),
    `cidr_col` STRING(MAX),
    `macaddr_col` STRING(MAX),
    `macaddr8_col` STRING(MAX),
) PRIMARY KEY (`id`)
-- PostgreSQL
CREATE TABLE "uuid_network_types" (
    "id" UUID NOT NULL ,
    "uuid_col" UUID,
    "inet_col" VARCHAR(2621440),
    "cidr_col" VARCHAR(2621440),
    "macaddr_col" VARCHAR(2621440),
    "macaddr8_col" VARCHAR(2621440),
    PRIMARY KEY ("id")
)
==
-- pg_time_and_interval_types
CREATE TABLE time_types (
    id bigint PRIMARY KEY,
    time_col time,
    time_without_tz_col time without time zone,
    timetz_col timetz,
    time_with_tz_col time with time zone,
    interval_col interval
)
-- GoogleSQL
CREATE TABLE `time_types` (
    `id` INT64 NOT NULL ,
    `time_col` STRING(MAX),
    `time_without_tz_col` STRING(MAX),
    `timetz_col` STRING(MAX),
    `time_with_tz_col` STRING(MAX),
    `interval_col` STRING(MAX),
) PRIMARY KEY (`id`)
-- PostgreSQL
CREATE TABLE "time_types" (
    "id" INT8 NOT NULL ,
    "time_col" VARCHAR(2621440),
    "time_without_tz_col" VARCHAR(2621440),
    "timetz_col" VARCHAR(2621440),
    "time_with_tz_col" VARCHAR(2621440),
    "interval_col" VARCHAR(2621440),
    PRIMARY KEY ("id")
)
==
-- pg_bit_types
CREATE TABLE bit_types (
    id bigint PRIMARY KEY,
    bit_col bit,
    bit_n_col bit(32),
    varbit_col varbit,
    varbit_n_col varbit(32),
    bit_varying_col bit varying(16)
)
-- GoogleSQL
CREATE TABLE `bit_types` (
    `id` INT64 NOT NULL ,
    `bit_col` BYTES(MAX),
    `bit_n_col` BYTES(MAX),
    `varbit_col` BYTES(MAX),
    `varbit_n_col` BYTES(MAX),
    `bit_varying_col` BYTES(MAX),
) PRIMARY KEY (`id`)
-- PostgreSQL
CREATE TABLE "bit_types" (
    "id" INT8 NOT NULL ,
    "bit_col" BYTEA,
    "bit_n_col" BYTEA,
    "varbit_col" BYTEA,
    "varbit_n_col" BYTEA,
    "bit_varying_col" BYTEA,
    PRIMARY KEY ("id")
)
==
-- pg_serial_types
CREATE TABLE serial_types (
    id bigint PRIMARY KEY,
    smallserial_col smallserial,
    serial2_col serial2,
    serial_col serial,
    serial4_col serial4,
    bigserial_col bigserial,
    serial8_col serial8
)
-- GoogleSQL
CREATE TABLE `serial_types` (
    `id` INT64 NOT NULL ,
    `smallserial_col` INT64 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    `serial2_col` INT64 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    `serial_col` INT64 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    `serial4_col` INT64 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    `bigserial_col` INT64 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    `serial8_col` INT64 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
) PRIMARY KEY (`id`)
-- PostgreSQL
CREATE TABLE "serial_types" (
    "id" INT8 NOT NULL ,
    "smallserial_col" INT8 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    "serial2_col" INT8 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    "serial_col" INT8 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    "serial4_col" INT8 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    "bigserial_col" INT8 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    "serial8_col" INT8 GENERATED BY DEFAULT AS IDENTITY (BIT_REVERSED_POSITIVE),
    PRIMARY KEY ("id")
)
==
-- pg_uuid_not_null_and_foreign_key
CREATE TABLE uuid_parent (
    id uuid PRIMARY KEY,
    label varchar(64) NOT NULL
);
CREATE TABLE uuid_child (
    id uuid PRIMARY KEY,
    parent_id uuid NOT NULL REFERENCES uuid_parent(id),
    note text
)
-- GoogleSQL
CREATE TABLE `uuid_child` (
    `id` UUID NOT NULL ,
    `parent_id` UUID NOT NULL ,
    `note` STRING(MAX),
) PRIMARY KEY (`id`)
CREATE TABLE `uuid_parent` (
    `id` UUID NOT NULL ,
    `label` STRING(64) NOT NULL ,
) PRIMARY KEY (`id`)
ALTER TABLE `uuid_child` ADD FOREIGN KEY (`parent_id`) REFERENCES `uuid_parent` (`id`) ON DELETE NO ACTION
-- PostgreSQL
CREATE TABLE "uuid_child" (
    "id" UUID NOT NULL ,
    "parent_id" UUID NOT NULL ,
    "note" VARCHAR(2621440),
    PRIMARY KEY ("id")
)
CREATE TABLE "uuid_parent" (
    "id" UUID NOT NULL ,
    "label" VARCHAR(64) NOT NULL ,
    PRIMARY KEY ("id")
)
ALTER TABLE "uuid_child" ADD FOREIGN KEY ("parent_id") REFERENCES "uuid_parent" ("id") ON DELETE NO ACTION
==
